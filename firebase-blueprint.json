{
  "entities": {
    "Report": {
      "title": "Diagnosis Report",
      "description": "A record of a crop diagnosis performed by a user.",
      "type": "object",
      "properties": {
        "cropIssue": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "symptoms": { "type": "string" },
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "actions": { "type": "array", "items": { "type": "string" } },
        "spreadRisk": { "type": "string" }
      },
      "required": ["cropIssue", "severity", "timestamp", "userId"]
    }
  },
  "firestore": {
    "reports": {
      "schema": "Report",
      "description": "Collection of all diagnostic reports."
    }
  }
}

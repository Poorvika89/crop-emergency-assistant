rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidReport(report) {
      return report.cropIssue is string &&
             report.severity in ['LOW', 'MEDIUM', 'HIGH'] &&
             report.userId == request.auth.uid &&
             report.timestamp is timestamp;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidReport(request.resource.data);
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
